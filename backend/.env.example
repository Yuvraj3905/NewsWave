# Server
PORT=4000
NODE_ENV=development

# CORS - comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@localhost:5432/newswave
DATABASE_SSL=false

# JWT
JWT_SECRET=replace-me-with-long-random-string
JWT_EXPIRES_IN=12h

# Seed Manager (created on first boot if no manager exists)
SEED_MANAGER_USERNAME=admin
SEED_MANAGER_PASSWORD=changeme123
SEED_MANAGER_ROLE=admin

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=newswave

# Social Distribution Webhook (Make.com / Zapier scenario URL)
SOCIAL_WEBHOOK_URL=

# Public site URL (used in webhook payload for article links)
PUBLIC_SITE_URL=http://localhost:3000

# Native social posting (optional - leave empty to skip a platform)
# X / Twitter (OAuth 1.0a User Context, developer.x.com)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Facebook Page (Graph API, developers.facebook.com)
FB_PAGE_ID=
FB_PAGE_TOKEN=

# Instagram Business (linked to FB Page; uses same FB_PAGE_TOKEN)
IG_USER_ID=
